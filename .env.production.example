# Joist frontend: production environment.
#
# Copy to `.env.production.local` on the host (gitignored) BEFORE running
# `npm run build`. Both values are read at build time: NEXT_PUBLIC_* is
# inlined into the browser bundle, and the /api rewrite target is fixed when
# the build is made. Runbook: crm_backend/docs/guide/hosting.md.

# The browser calls the API on the same origin, through Next's rewrite.
NEXT_PUBLIC_API_BASE_URL=/api

# Where the rewrite sends /api/* on this host (the backend's HOST:PORT).
API_INTERNAL_BASE_URL=http://127.0.0.1:4000
